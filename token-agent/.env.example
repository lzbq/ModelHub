# ModelHub Agent 环境变量示例。复制为 .env 后再填写真实值。
APP_NAME=ModelHub-Agent
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# LLM：必填。也可配置兼容 Anthropic 协议的第三方地址和模型名。
ANTHROPIC_API_KEY=replace_with_your_key
# ANTHROPIC_BASE_URL=https://example.com/anthropic
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Redis：Agent 会话记忆。带密码时写成 redis://:password@host:6379/0。
REDIS_URL=redis://192.168.100.128:6379/0

# Milvus：RAG、情景记忆和用户画像。
MILVUS_URI=http://192.168.100.128:19530
MILVUS_TOKEN=
MILVUS_KNOWLEDGE_COLLECTION=modelhub_knowledge
MILVUS_EPISODIC_COLLECTION=modelhub_episodic
MILVUS_PROFILE_COLLECTION=modelhub_user_profile

# 中文 Embedding。首次运行 sentence-transformers 会加载对应模型。
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
MILVUS_DIM=512
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# ModelHub Java 后端。
MODELHUB_TOOLS_ENABLED=true
MODELHUB_API_BASE_URL=http://127.0.0.1:8081
MODELHUB_API_TIMEOUT=5

# 主应用 Agent 的受限只读 tool-use 循环。
AGENT_TOOL_USE_ENABLED=true
AGENT_TOOL_MAX_ROUNDS=3
AGENT_TOOL_MAX_CALLS=4
AGENT_TOOL_MAX_PARALLEL_CALLS=3
AGENT_TOOL_RESULT_MAX_CHARS=8000

# 私有订单/额度只接受 HTTP Authorization: Bearer <token>。
ALLOW_LEGACY_BODY_AUTH_TOKEN=false
MODELHUB_DEBUG_PRIVATE_TOOLS=false

# 标准 MCP 服务（默认 stdio；HTTP 启动时使用下列监听地址）。
MODELHUB_MCP_TRANSPORT=stdio
MODELHUB_MCP_HOST=127.0.0.1
MODELHUB_MCP_PORT=8010

# 仓库级 Agent Skills；相对路径从项目根目录解析。
PROJECT_SKILLS_DIR=.agents/skills

# 可选能力。
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/modelhub
PROMETHEUS_PORT=0
ANOMALY_DETECTION_THRESHOLD=2.0
EVAL_BASELINE_PATH=./data/eval/baseline.json
# /eval/run 默认关闭；启用时请配置高强度管理员密钥，并通过 Authorization: Bearer 发送。
EVAL_ADMIN_TOKEN=
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
